#!/bin/bash

# Input file
JSON_FILE="data.json"

# Check if the JSON file exists
if [ ! -f "$JSON_FILE" ]; then
    echo "Error: $JSON_FILE not found. Please ensure the API request script was run successfully."
    exit 1
fi

# Extract Pokémon data using jq
name=$(jq -r '.name' "$JSON_FILE")
height=$(jq -r '.height' "$JSON_FILE")
weight=$(jq -r '.weight' "$JSON_FILE")
type=$(jq -r '.types[0].type.name' "$JSON_FILE")

# Convert height to meters (assuming height is in decimeters) and format it using sed
formatted_height=$(awk "BEGIN { printf \"%.1f\", $height / 10 }" | sed 's/\.0$//')

# Convert weight to kilograms (assuming weight is in hectograms) and format it using sed
formatted_weight=$(awk "BEGIN { printf \"%.1f\", $weight / 10 }" | sed 's/\.0$//')

# Capitalize the first letter of the type using sed
type=$(echo "$type" | sed 's/^\(.\)/\U\1/')

# Format the output
output="$name is of type $type, weighs ${formatted_weight}kg, and is ${formatted_height}m tall."

# Display the output
echo "$output"
