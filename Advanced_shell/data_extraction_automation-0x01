#!/bin/bash

# Input file
JSON_FILE="data.json"

# Check if the JSON file exists
if [ ! -f "$JSON_FILE" ]; then
    echo "Error: $JSON_FILE not found. Please ensure the API request script was run successfully."
    exit 1
fi

# Extract Pokémon data using jq
NAME=$(jq -r '.name' "$JSON_FILE")
HEIGHT=$(jq -r '.height' "$JSON_FILE")
WEIGHT=$(jq -r '.weight' "$JSON_FILE")
TYPE=$(jq -r '.types[0].type.name' "$JSON_FILE")

# Convert height to meters (assuming height is in decimeters)
HEIGHT_M=$(awk "BEGIN { printf \"%.1f\", $HEIGHT / 10 }")

# Convert weight to kilograms (assuming weight is in hectograms)
WEIGHT_KG=$(awk "BEGIN { printf \"%.1f\", $WEIGHT / 10 }")

# Format the output
OUTPUT="$NAME is of type $TYPE, weighs ${WEIGHT_KG}kg, and is ${HEIGHT_M}m tall."

# Display the output
echo "$OUTPUT"
