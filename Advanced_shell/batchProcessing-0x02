#!/bin/bash

# List of Pokémon in lowercase
POKEMON_LIST=("bulbasaur" "ivysaur" "venusaur" "charmander" "charmeleon")

# Base URL of the Pokémon API
API_URL="https://pokeapi.co/api/v2/pokemon"

# Directory to store JSON files
OUTPUT_DIR="pokemon_data"

# Ensure the output directory exists
mkdir -p "$OUTPUT_DIR"

# Retry limit
RETRY_LIMIT=3

# Loop through each Pokémon in the list
for POKEMON in "${POKEMON_LIST[@]}"; do
    # Create the filename based on the Pokémon's name
    POKEMON_FILE="$OUTPUT_DIR/$POKEMON.json"

    echo "Fetching data for $POKEMON..."

    # Initialize retry counter
    RETRY_COUNT=0
    SUCCESS=false

    # Retry loop
    while [ $RETRY_COUNT -lt $RETRY_LIMIT ]; do
        # Make the API request and save the response to the corresponding file
        curl -s "$API_URL/$POKEMON" -o "$POKEMON_FILE"

        # Check if the request was successful
        if [ $? -eq 0 ]; then
            if jq empty "$POKEMON_FILE" 2>/dev/null; then
                echo "Data for $POKEMON saved to $POKEMON_FILE"
                SUCCESS=true
                break
            else
                echo "Invalid JSON received for $POKEMON."
                rm -f "$POKEMON_FILE"
            fi
        fi

        # Increment retry counter
        RETRY_COUNT=$((RETRY_COUNT + 1))

        # Wait before retrying
        echo "Retrying ($RETRY_COUNT/$RETRY_LIMIT) for $POKEMON..."
        sleep 2
    done

    # If still unsuccessful after retries, log the error
    if [ "$SUCCESS" = false ]; then
        echo "Failed to fetch data for $POKEMON after $RETRY_LIMIT attempts." >> errors.txt
    fi

    # Add a delay to handle potential rate-limiting
    sleep 2
done

echo "Batch processing complete. Data saved in $OUTPUT_DIR."
